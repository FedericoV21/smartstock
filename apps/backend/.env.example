# SmartStock API (Nest) ÔÇö objetivo de despliegue: Postgres gestionado + Nest en la nube,
# frontend Next por separado. Sin acoplar el backend a un proveedor SaaS de base de datos.

PORT=4000

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=smartstock_backend
DB_SSL=false
DB_LOGGING=false

# Secreto HS256 para validar JWT de usuarios (definir al menos uno).
# JWT_SECRET=
# SUPABASE_JWT_SECRET=

# Opcional: cifrado de certificados ARCA en BD (32 caracteres exactos).
# ARCA_ENCRYPTION_KEY=

# Worker cola ARCA (Postgres + funciones claim_arca_jobs): POST /api/v1/internal/arca-jobs/run
# Header: x-arca-worker-secret: <valor>
# ARCA_WORKER_SECRET=
# ARCA_WORKER_BATCH_SIZE=5
# ARCA_WORKER_STUB=false

# Cron HTTP (Vercel / scheduler externo): Authorization: Bearer <CRON_SECRET>
# GET /api/v1/cron/reintentar-arca  — reintentos síncronos pendiente_arca (lote 10)
# POST /api/v1/cron/arca-procesar   — cola arca_job (lote ~5)
# POST /api/v1/cron/whatsapp/expire-otp | purge-agent-logs | branch-timeout | send-outbound | process-queued
# CRON_SECRET=

# NB-WA-001 — WhatsApp / Meta Cloud API
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# WHATSAPP_WEBHOOK_APP_SECRET=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PLATFORM_PHONE_NUMBER_ID=
# WHATSAPP_GRAPH_API_VERSION=v20.0
# APP_URL=http://localhost:4000
# WHATSAPP_OTP_AUTO_FLUSH_OUTBOUND=true
# WHATSAPP_AUTO_FLUSH_OUTBOUND=true

# NB-ARC-106 — homologación AFIP real (manual o test:e2e:arca con ARCA_HOMO_E2E=1)
# Certificados: por tenant+sucursal en arca_config vía PUT /arca/config (no env del servidor).
# ARCA_HOMO_CERT_PATH / ARCA_HOMO_KEY_PATH = atajo opcional para subir PEM desde disco si la BD está vacía.
# ARCA_HOMO_E2E=0
# ARCA_HOMO_BASE_URL=http://localhost:4000
# ARCA_HOMO_CERT_PATH=/ruta/certificado-homo.pem
# ARCA_HOMO_KEY_PATH=/ruta/clave-homo.key
# ARCA_HOMO_CUIT=20123456789
# ARCA_HOMO_PUNTO_VENTA=3
# ARCA_HOMO_JWT=   # opcional; si vacío se firma con JWT_SECRET + tenant demo
# ARCA_HOMO_RUN_RETRY=1   # incluir flujo B (retry comprobante pendiente)

# PDF post-CAE ÔåÆ S3-compatible (R2 / MinIO). Si PDF_STORAGE_ENABLED=true, completar bucket, keys y URL p├║blica.
# PDF_STORAGE_ENABLED=false
# PDF_S3_BUCKET=
# PDF_S3_REGION=us-east-1
# PDF_S3_ENDPOINT=
# PDF_S3_FORCE_PATH_STYLE=false
# PDF_S3_ACCESS_KEY_ID=
# PDF_S3_SECRET_ACCESS_KEY=
# PDF_PUBLIC_BASE_URL=

# Miniaturas de producto (WebP) ÔåÆ S3/R2. Puede reutilizar endpoint/keys de PDF si solo cambia bucket y URL p├║blica.
# PRODUCT_IMAGE_STORAGE_ENABLED=false
# PRODUCT_IMAGE_S3_BUCKET=producto-imagenes
# PRODUCT_IMAGE_S3_REGION=
# PRODUCT_IMAGE_S3_ENDPOINT=
# PRODUCT_IMAGE_S3_FORCE_PATH_STYLE=false
# PRODUCT_IMAGE_S3_ACCESS_KEY_ID=
# PRODUCT_IMAGE_S3_SECRET_ACCESS_KEY=
# PRODUCT_IMAGE_PUBLIC_BASE_URL=

# Logo del negocio ÔåÆ S3/R2 (bucket tenant-logos). Si no se define, reutiliza credenciales de producto/PDF.
# TENANT_LOGO_STORAGE_ENABLED=false
# TENANT_LOGO_S3_BUCKET=tenant-logos
# TENANT_LOGO_PUBLIC_BASE_URL=

# Invitaci├│n de usuarios (POST /api/v1/config/users) v├¡a Supabase Auth Admin.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# PUBLIC_APP_BASE_URL=http://localhost:3000

# CORS (Next en local: http://localhost:3000). Producci├│n: lista separada por comas.
# NEST_CORS_ORIGINS=http://localhost:3000

# IA precios (POST /api/v1/ai/extract) y invoice-extractor público (POST /api/v1/public/invoice-extractor/extract).
# Claves de producto: tabla api_extractor_key (scope invoice:extract), no env.
# GEMINI_API_KEY=
# OPEN_ROUTER_API_KEY=
# OPEN_ROUTER_MODELS=google/gemini-2.5-pro
# IA_VISION_PRIMARY=auto
# IA_EXTRACCIONES_LIMITE_MENSUAL=4
# IA_PDF_PAGES_PER_CHUNK=4
# IA_VISION_MAX_OUTPUT_TOKENS=32768

# Panel interno Nexus (POST /api/v1/nexus-dashboard/login). Cookie HMAC 8h.
# NEXUS_DASHBOARD_PASSWORD=
# NEXUS_DASHBOARD_SECRET=
