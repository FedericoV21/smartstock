# SmartStock API (Nest) ÔÇö objetivo de despliegue: Postgres gestionado + Nest en la nube,
# frontend Next por separado. Sin acoplar el backend a un proveedor SaaS de base de datos.

PORT=4000

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=smartstock_backend
DB_SSL=false
DB_LOGGING=false

# Secreto HS256 para validar JWT de usuarios (definir al menos uno).
# JWT_SECRET=
# SUPABASE_JWT_SECRET=

# Opcional: cifrado de certificados ARCA en BD (32 caracteres exactos).
# ARCA_ENCRYPTION_KEY=

# Worker cola ARCA (Postgres + funciones claim_arca_jobs): POST /api/v1/internal/arca-jobs/run
# Header: x-arca-worker-secret: <valor>
# ARCA_WORKER_SECRET=
# ARCA_WORKER_BATCH_SIZE=5
# ARCA_WORKER_STUB=false

# PDF post-CAE ÔåÆ S3-compatible (R2 / MinIO). Si PDF_STORAGE_ENABLED=true, completar bucket, keys y URL p├║blica.
# PDF_STORAGE_ENABLED=false
# PDF_S3_BUCKET=
# PDF_S3_REGION=us-east-1
# PDF_S3_ENDPOINT=
# PDF_S3_FORCE_PATH_STYLE=false
# PDF_S3_ACCESS_KEY_ID=
# PDF_S3_SECRET_ACCESS_KEY=
# PDF_PUBLIC_BASE_URL=

# Miniaturas de producto (WebP) ÔåÆ S3/R2. Puede reutilizar endpoint/keys de PDF si solo cambia bucket y URL p├║blica.
# PRODUCT_IMAGE_STORAGE_ENABLED=false
# PRODUCT_IMAGE_S3_BUCKET=producto-imagenes
# PRODUCT_IMAGE_S3_REGION=
# PRODUCT_IMAGE_S3_ENDPOINT=
# PRODUCT_IMAGE_S3_FORCE_PATH_STYLE=false
# PRODUCT_IMAGE_S3_ACCESS_KEY_ID=
# PRODUCT_IMAGE_S3_SECRET_ACCESS_KEY=
# PRODUCT_IMAGE_PUBLIC_BASE_URL=

# Logo del negocio ÔåÆ S3/R2 (bucket tenant-logos). Si no se define, reutiliza credenciales de producto/PDF.
# TENANT_LOGO_STORAGE_ENABLED=false
# TENANT_LOGO_S3_BUCKET=tenant-logos
# TENANT_LOGO_PUBLIC_BASE_URL=

# Invitaci├│n de usuarios (POST /api/v1/config/users) v├¡a Supabase Auth Admin.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# PUBLIC_APP_BASE_URL=http://localhost:3000

# CORS (Next en local: http://localhost:3000). Producci├│n: lista separada por comas.
# NEST_CORS_ORIGINS=http://localhost:3000

# IA precios (POST /api/v1/ai/extract). Al menos uno: Gemini u OpenRouter.
# GEMINI_API_KEY=
# OPEN_ROUTER_API_KEY=
# OPEN_ROUTER_MODELS=google/gemini-2.5-pro
# IA_VISION_PRIMARY=auto
# IA_EXTRACCIONES_LIMITE_MENSUAL=4
# IA_PDF_PAGES_PER_CHUNK=4
# IA_VISION_MAX_OUTPUT_TOKENS=32768
